{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branch Visualizer",
  "version": "1.0.2",
  "identifier": "com.branchvisualizer.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Branch Visualizer",
        "width": 420,
        "height": 560,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1OUFBQzc3MzlDOTU4QzcKUldUSFdNazVkNnlhcFRMTXdzemV6RS9SQ1h5VnNtSHZxbFRzQmRpR21zYzUzNEI2MWlBQW8rdnYK",
      "endpoints": [
        "https://github.com/wannabeepolymath/git-branch-Visualizer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
